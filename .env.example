# ============================================================
# Discord Bot — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ── Discord ──────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_bot_client_id_here

# Optional: restrict slash command deployment to one guild (instant update)
# Leave blank to deploy globally (takes up to 1 hour to propagate)
GUILD_ID=your_test_guild_id_here

# ── AI Provider (choose at least one) ────────────────────────
# Claude (Anthropic) — recommended
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI — optional fallback
OPENAI_API_KEY=your_openai_api_key_here

# Which provider to use: "anthropic" | "openai"
AI_PROVIDER=anthropic

# ── Channel IDs (optional) ────────────────────────────────────
# Bot will send welcome messages here
WELCOME_CHANNEL_ID=

# Bot will respond to ALL messages in this channel (not just @mentions)
AI_CHANNEL_ID=

# ── Logging ───────────────────────────────────────────────────
# Levels: error | warn | info | debug
LOG_LEVEL=info
